{
  "MarketData": {
    "Alpaca": {
      "StreamEnabled": true,
      "StreamSymbols": "SPY,RKLX,ASTX,XRPN",
      "Feed": "iex",
      "DailyFeed": "sip_delayed",
      "AllowDelayedHistoricalSipMinutes": true
    },
    "Intraday": {
      "OpeningEntryHoldMinutes": 60
    }
  },
  "BoringOvernight": {
    "ReadySignalMode": "shadow",
    "ReadyTargetQuantilePct": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
